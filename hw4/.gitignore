# Secrets (never commit). Only .env.example, with placeholders, is tracked.
.env
.env.*
!.env.example
frontend/.env

# Data pack: the database and the store's product images (never commit)
data/
products/
campus_customs.db
*.db
*.jpg
*.jpeg

# Python
.venv/
__pycache__/

# Frontend (merged from Vite's default frontend/.gitignore)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local only
.DS_Store
.claude/
output/test_accounts.env
